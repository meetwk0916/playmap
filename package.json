{
  "name": "playmap",
  "private": true,
  "scripts": {
    "predev": "node scripts/check-local-server.cjs",
    "dev": "python3 -m http.server 4173 --bind 127.0.0.1",
    "check:design": "node scripts/check-design-discipline.mjs && npm run check:places",
    "check:places": "node scripts/check-public-places.mjs && node --test tests/public-places-city.test.mjs",
    "test": "playwright test",
    "test:album": "node --test tests/album-*.test.mjs",
    "test:release": "node --test tests/release-verification.test.mjs",
    "verify:production": "node scripts/verify-production.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0"
  }
}
