{
  "name": "playmap",
  "private": true,
  "scripts": {
    "predev": "node scripts/check-local-server.cjs",
    "dev": "python3 -m http.server \"${PLAYMAP_PORT:-4173}\" --bind 127.0.0.1",
    "check:preview": "node scripts/check-local-server.cjs --running",
    "check:design": "node scripts/check-design-discipline.mjs && npm run check:places",
    "check:docs": "node --test tests/doc-links.test.mjs && node scripts/check-doc-links.mjs",
    "check:places": "node scripts/check-public-places.mjs && node --test tests/public-places-city.test.mjs",
    "test": "playwright test",
    "test:album": "node --test tests/album-*.test.mjs",
    "test:release": "node --test tests/release-verification.test.mjs",
    "verify:production": "node scripts/verify-production.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "github-slugger": "^2.0.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0"
  }
}
